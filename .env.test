# Loaded when APP_ENV=test (auto-detected under vitest via $VARLOCK_ENV).
# The secret-looking values here are dummies so validation passes with no
# real secrets present (e.g. on CI). Every bitwarden() ref in .env.schema
# must be overridden here so test loads never hit the network.

DATABASE_URL="postgresql://peace_user:peace_test@127.0.0.1:5433/peace_of_real_estate_test?sslmode=disable"
BETTER_AUTH_SECRET=dummy-auth-secret-for-tests-only
BETA_PASSWORD=dummy-beta-password
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
AVATAR_BUCKET=avatars
# Dummy: no test connects to S3, but the schema requires a URL.
AWS_ENDPOINT_URL="http://localhost:9000"
AWS_ACCESS_KEY_ID=peace_minio
AWS_SECRET_ACCESS_KEY=peace_minio_secret
BASE_URL="http://localhost:3000"
