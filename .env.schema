# This file uses @env-spec - see https://varlock.dev/env-spec for more info
# ---
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @import(./.env.compose, enabled=forEnv(development))
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production)
# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN)
# ---

# @type=bitwardenAccessToken @sensitive @optional
BITWARDEN_ACCESS_TOKEN=

# @type=enum(development, preview, staging, production, test)
APP_ENV=fallback($VARLOCK_ENV, development)

# @type=url @required
BETTER_AUTH_URL=if(forEnv(development), "http://localhost:3000", "https://peace-of-real-estate-production.up.railway.app")
# @required @sensitive
BETTER_AUTH_SECRET=

# Railway injects this at runtime; the baked blob must not shadow it, so prod
# boot-asserts it instead (src/db/connection.ts).
# @required=forEnv(development) @type=url @sensitive
DATABASE_URL=

# @required=forEnv(production, preview, staging)
GOOGLE_CLIENT_ID=bitwarden("9e2368ac-7809-4be1-9910-b49c0074e4f3")
# @required=forEnv(production, preview, staging) @sensitive
GOOGLE_CLIENT_SECRET=bitwarden("8ee843f6-f9d9-4c04-ba41-b49c0074f582")

# @required @sensitive
BETA_PASSWORD=bitwarden("f68b023f-316d-40c6-9d01-b49c0074aa7b")

# @optional
# Pending: not yet read anywhere in the app.
ADMIN_EMAILS=

# @required
AVATAR_BUCKET=
AWS_REGION=us-east-1
# @required @type=url
AWS_ENDPOINT_URL="https://t3.storageapi.dev"
# @required
AWS_ACCESS_KEY_ID=
# @required @sensitive
AWS_SECRET_ACCESS_KEY=

# @required=forEnv(production, staging) @sensitive
# @docs(https://resend.com/docs/dashboard/api-keys/introduction)
RESEND_API_KEY=
# @required=forEnv(production, preview, staging) @type=email
FROM_EMAIL="noreply@ariaamini.com"

# @required=forEnv(production)
VITE_PUBLIC_POSTHOG_KEY=

# @required=forEnv(production, preview, staging) @type=url
VITE_PUBLIC_SENTRY_DSN=

# @required=forEnv(production, preview, staging) @sensitive
# @docs(https://sentry.io/settings/auth-tokens/)
SENTRY_AUTH_TOKEN=
