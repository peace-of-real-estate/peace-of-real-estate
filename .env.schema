# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# ---
# Current deployment environment. Auto-detected via $VARLOCK_ENV (resolves
# to "test" under vitest, branch-aware in CI). Set APP_ENV explicitly in
# your hosting platform's env vars (staging/production) or override ad hoc
# via APP_ENV=xxx when running commands.

# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @import(./.env.compose, enabled=forEnv(development))
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production)
# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN)
# ---

# Bitwarden Secrets Manager machine account token. Set locally in .env.local
# (use varlock(prompt)); set as a service var in Railway/CI. Secret values
# themselves live in BWS (projects: pre-dev, pre-prod) and are referenced via
# bitwarden("uuid") below - never paste raw secret values into committed files.
# @type=bitwardenAccessToken @sensitive @optional
BITWARDEN_ACCESS_TOKEN=

# @type=enum(development, preview, staging, production, test)
APP_ENV=fallback($VARLOCK_ENV, development)

# @type=url @required
BETTER_AUTH_URL=if(forEnv(development, test), "http://localhost:3000", "https://peace-of-real-estate-production.up.railway.app")
# @required @sensitive
BETTER_AUTH_SECRET=

# @required @type=url @sensitive
DATABASE_URL=

# @required=forEnv(production, staging)
GOOGLE_CLIENT_ID=bitwarden("9e2368ac-7809-4be1-9910-b49c0074e4f3")
# @required=forEnv(production, staging) @sensitive
GOOGLE_CLIENT_SECRET=bitwarden("8ee843f6-f9d9-4c04-ba41-b49c0074f582")

# @required @sensitive
BETA_PASSWORD=bitwarden("f68b023f-316d-40c6-9d01-b49c0074aa7b")

# @optional
# Pending: not yet read anywhere in the app.
ADMIN_EMAILS=

# @required
AVATAR_BUCKET=
AWS_REGION=us-east-1
# No default: per-workspace MinIO port generated into .env.development.local
# by scripts/setup.ts; real endpoints set per env (.env.production etc).
# @required @type=url @sensitive=false
AWS_ENDPOINT_URL=
# @required
AWS_ACCESS_KEY_ID=
# @required @sensitive
AWS_SECRET_ACCESS_KEY=

# @optional @sensitive
# @required=forEnv(production, staging) @sensitive
# @docs(https://resend.com/docs/dashboard/api-keys/introduction)
RESEND_API_KEY=
# @required=forEnv(production, staging) @type=email
FROM_EMAIL="noreply@ariaamini.com"

# @required=forEnv(production)
VITE_PUBLIC_POSTHOG_KEY=

# @required=forEnv(production, preview, staging) @type=url
VITE_PUBLIC_SENTRY_DSN=
#
# @required=forEnv(production, preview, staging) @sensitive
# Org auth token for source map uploads at build time:
# https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=

# @required=forEnv(test) @type=url
BASE_URL=
