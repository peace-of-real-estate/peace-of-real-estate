# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# ---
# Current deployment environment. Auto-detected via $VARLOCK_ENV (resolves
# to "test" under vitest, branch-aware in CI). Set APP_ENV explicitly in
# your hosting platform's env vars (staging/production) or override ad hoc
# via APP_ENV=xxx when running commands.

# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production)

# @type=enum(development, preview, staging, production, test)
APP_ENV=fallback($VARLOCK_ENV, development)

# @type=url @required
BETTER_AUTH_URL=if(forEnv(development, test), "http://localhost:3000", "https://peace-of-real-estate-production.up.railway.app")
# @required @sensitive
BETTER_AUTH_SECRET=

# @required @type=url @sensitive
DATABASE_URL=

# @required=forEnv(production, staging)
GOOGLE_CLIENT_ID=
# @required=forEnv(production, staging) @sensitive
GOOGLE_CLIENT_SECRET=

# @required @sensitive
BETA_PASSWORD=

# @optional
# Pending: not yet read anywhere in the app.
ADMIN_EMAILS=

# @required
AVATAR_BUCKET=
AWS_REGION=us-east-1
# @type=url
AWS_ENDPOINT_URL="https://t3.storageapi.dev"
# @required
AWS_ACCESS_KEY_ID=
# @required @sensitive
AWS_SECRET_ACCESS_KEY=

# @optional @type=url
AI_BASE_URL=
# @optional
AI_MODEL=
# @optional @sensitive
AI_API_KEY=
 
# @required=forEnv(production, staging) @sensitive
# @docs(https://resend.com/docs/dashboard/api-keys/introduction)
RESEND_API_KEY=
# @required=forEnv(production, staging) @type=email
FROM_EMAIL="noreply@ariaamini.com"

# @optional @type=email
# In non-production, redirects every outgoing email to this address and notes
# the intended recipient in the subject/body. Resend rejects reserved domains
# (example.com, .test, ...) which seeded users use, so without this override
# those emails are logged to the console instead of sent.
# TODO: delete this (and the redirect logic in src/lib/email.server.ts) before
# launch — it's a dev-only convenience.
DEV_EMAIL_OVERRIDE=

# @required=forEnv(production, staging) @sensitive
STRIPE_SECRET_KEY=
# @required=forEnv(production, staging) @sensitive
STRIPE_WEBHOOK_SECRET=
# @required=forEnv(production, staging)
STRIPE_INTRO_UNLOCK_PRICE_ID=

# @required=forEnv(production)
VITE_PUBLIC_POSTHOG_KEY=

# @required=forEnv(test) @type=url
BASE_URL=
